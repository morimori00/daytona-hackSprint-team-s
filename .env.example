# Copy to .env.local and fill in. Never commit the filled-in file.

# --- Required to post results -------------------------------------------------
# Needs: issues:write (comments) + contents:write (publish the recording).
GITHUB_TOKEN=
# Shared secret you also paste into the repo's webhook settings.
GITHUB_WEBHOOK_SECRET=

# --- Required to drive the browser -------------------------------------------
# Fireworks is the default provider and wins if set. It speaks the OpenAI wire
# format, so browser-use talks to it through the OpenAI client with a base_url.
FIREWORKS_API_KEY=
# REPRO_MODEL=accounts/fireworks/models/glm-5p2
# glm-5p2 reasons before answering; too low a cap truncates the real reply.
# REPRO_MAX_TOKENS=8192

# Fallbacks, only used when FIREWORKS_API_KEY is unset.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Sandbox ------------------------------------------------------------------
# local  = run the reproduction on this machine (no Daytona needed)
# daytona = run it in a disposable sandbox
RUNNER=local
DAYTONA_API_KEY=
# Prebuilt snapshot the sandbox boots from. Build it with `npm run snapshot`.
# DAYTONA_SNAPSHOT=repro-sandbox
# What the sandbox clones. Defaults to the repo the issue came from; set this
# only to point a rehearsal at a different checkout.
# REPRO_REPO_URL=

# --- Optional -----------------------------------------------------------------
# TRIGGER_LABEL=Reproducibility
# SEED_APP_PORT=3100
# REPRO_TIMEOUT_MS=300000
# REPRO_FPS=10
# Path to a Chromium/Chrome binary. Required in the sandbox; auto-detected on macOS.
# BROWSER_PATH=
